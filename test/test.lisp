(defun brute-mcf-slope (n edges s tt)
  (let ((g (make-array n :initial-element nil))
        (caps (make-array (* 2 (length edges))))
        (tos (make-array (* 2 (length edges))))
        (costs (make-array (* 2 (length edges))))
        (flow 0) (cost 0) (points (list (cons 0 0))))
    (loop for (u v c w) in edges
          for i from 0
          do (setf (svref caps (* 2 i)) c (svref tos (* 2 i)) v (svref costs (* 2 i)) w
                   (svref caps (1+ (* 2 i))) 0 (svref tos (1+ (* 2 i))) u (svref costs (1+ (* 2 i))) (- w))
             (push (* 2 i) (svref g u))
             (push (1+ (* 2 i)) (svref g v)))
    (loop
      (let ((dist (make-array n :initial-element nil))
            (prev (make-array n :initial-element nil)))
        (setf (svref dist s) 0)
        (loop repeat n
              do (dotimes (v n)
                   (when (svref dist v)
                     (dolist (id (svref g v))
                       (when (and (> (svref caps id) 0)
                                  (or (null (svref dist (svref tos id)))
                                      (< (+ (svref dist v) (svref costs id)) (svref dist (svref tos id)))))
                         (setf (svref dist (svref tos id)) (+ (svref dist v) (svref costs id))
                               (svref prev (svref tos id)) id))))))
        (unless (svref dist tt) (return))
        (let ((c nil) (v tt))
          (loop while (/= v s)
                do (let ((id (svref prev v)))
                     (when (or (null c) (< (svref caps id) c)) (setf c (svref caps id)))
                     (setf v (svref tos (logxor id 1)))))
          (setf v tt)
          (loop while (/= v s)
                do (let ((id (svref prev v)))
                     (decf (svref caps id) c)
                     (incf (svref caps (logxor id 1)) c)
                     (setf v (svref tos (logxor id 1)))))
          (incf flow c)
          (incf cost (* c (svref dist tt)))
          (push (cons flow cost) points))))
    (values flow cost (nreverse points))))

(defun slope-cost-at (points f)
  (loop for (p . q) on points
        when (and q (<= (car p) f (car (car q))))
          return (+ (cdr p) (/ (* (- f (car p)) (- (cdr (car q)) (cdr p))) (- (car (car q)) (car p))))
        finally (return (cdr (car (last points))))))

(deftest test-mincostflow
  (dotimes (iter 300)
    (let* ((n (rnd 2 7))
           (m (rnd 0 14))
           (s (rnd 0 (1- n)))
           (tt (let ((x (rnd 0 (- n 2)))) (if (>= x s) (1+ x) x)))
           (edges (loop repeat m collect (list (rnd 0 (1- n)) (rnd 0 (1- n)) (rnd 0 6) (rnd 0 9))))
           (g (make-mcf-graph n)))
      (dolist (e edges) (apply #'mcf-graph-add-edge g e))
      (multiple-value-bind (bf bc bpoints) (brute-mcf-slope n edges s tt)
        (let ((slope (mcf-graph-slope g s tt)))
          (check (equal (car (last slope)) (cons bf bc)))
          (check (equal (first slope) (cons 0 0)))
          (loop for (p q r) on slope
                while r
                do (check (/= (* (- (car q) (car p)) (- (cdr r) (cdr q)))
                              (* (- (car r) (car q)) (- (cdr q) (cdr p))))))
          (dolist (p slope)
            (check (= (cdr p) (slope-cost-at bpoints (car p)))))
          (let ((total 0)
                (balance (make-array n :initial-element 0)))
            (loop for e in (mcf-graph-edges g)
                  do (check (<= 0 (mcf-edge-flow e) (mcf-edge-cap e)))
                     (incf total (* (mcf-edge-flow e) (mcf-edge-cost e)))
                     (decf (svref balance (mcf-edge-from e)) (mcf-edge-flow e))
                     (incf (svref balance (mcf-edge-to e)) (mcf-edge-flow e)))
            (check (= total bc))
            (dotimes (v n)
              (check (= (svref balance v) (cond ((= v s) (- bf)) ((= v tt) bf) (t 0)))))))
        (when (> bf 0)
          (let ((g2 (make-mcf-graph n))
                (lim (rnd 0 bf)))
            (dolist (e edges) (apply #'mcf-graph-add-edge g2 e))
            (multiple-value-bind (f c) (mcf-graph-flow g2 s tt lim)
              (check (= f lim))
              (check (= c (slope-cost-at bpoints lim))))))))))

(deftest test-scc
  (dotimes (iter 300)
    (let* ((n (rnd 1 12))
           (m (rnd 0 30))
           (edges (loop repeat m collect (cons (rnd 0 (1- n)) (rnd 0 (1- n)))))
           (g (make-scc-graph n))
           (reach (make-array (list n n) :initial-element nil)))
      (dolist (e edges) (scc-graph-add-edge g (car e) (cdr e)))
      (dotimes (i n) (setf (aref reach i i) t))
      (dolist (e edges) (setf (aref reach (car e) (cdr e)) t))
      (dotimes (k n)
        (dotimes (i n)
          (dotimes (j n)
            (when (and (aref reach i k) (aref reach k j)) (setf (aref reach i j) t)))))
      (let* ((groups (scc-graph-scc g))
             (id (make-array n :initial-element nil)))
        (loop for grp in groups
              for k from 0
              do (dolist (v grp) (setf (svref id v) k)))
        (check (every #'identity id))
        (check (= n (reduce #'+ (mapcar #'length groups))))
        (dotimes (i n)
          (dotimes (j n)
            (check (eq (= (svref id i) (svref id j))
                       (and (aref reach i j) (aref reach j i))))))
        (dolist (e edges)
          (check (<= (svref id (car e)) (svref id (cdr e))))))))
  (let* ((n 200000) (g (make-scc-graph n)))
    (dotimes (i (1- n)) (scc-graph-add-edge g i (1+ i)))
    (scc-graph-add-edge g (1- n) 0)
    (check (= 1 (length (scc-graph-scc g))))))

(deftest test-twosat
  (dotimes (iter 300)
    (let* ((n (rnd 1 8))
           (m (rnd 0 20))
           (clauses (loop repeat m
                          collect (list (rnd 0 (1- n)) (zerop (random 2 *rng*))
                                        (rnd 0 (1- n)) (zerop (random 2 *rng*)))))
           (ts (make-two-sat n)))
      (dolist (c clauses) (apply #'two-sat-add-clause ts c))
      (flet ((ok (assign)
               (every (lambda (c)
                        (destructuring-bind (i f j g) c
                          (or (eq (svref assign i) f) (eq (svref assign j) g))))
                      clauses)))
        (let ((exists (loop for mask below (ash 1 n)
                            thereis (ok (coerce (loop for i below n collect (logbitp i mask)) 'vector))))
              (sat (two-sat-satisfiable ts)))
          (check (eq exists sat))
          (when sat (check (ok (two-sat-answer ts))))))))
  (let ((ts (make-two-sat 3)))
    (two-sat-add-clause ts 0 t 0 t)
    (two-sat-add-clause ts 1 nil 1 nil)
    (two-sat-add-clause ts 2 t 2 t)
    (check (two-sat-satisfiable ts))
    (let ((before (two-sat-answer ts)))
      (check (equalp before #(t nil t)))
      (two-sat-add-clause ts 2 nil 2 nil)
      (check (not (two-sat-satisfiable ts)))
      (check (equalp (two-sat-answer ts) before)))))

(defun run-all ()
  (setf *checks* 0 *failures* 0)
  (dolist (test '(test-dsu test-fenwick-tree test-segtree test-lazy-segtree
                  test-specialized-segtrees test-string
                  test-math test-modint test-convolution test-maxflow test-mincostflow
                  test-scc test-twosat))
    (let ((before *failures*)
          (start (get-internal-real-time)))
      (handler-case (funcall test)
        (error (e)
          (incf *failures*)
          (format t "ERROR [~A]: ~A~%" *current* e)))
      (format t "~A ~A (~,2Fs)~%"
              (if (= before *failures*) "ok  " "FAIL")
              (string-downcase (symbol-name test))
              (/ (- (get-internal-real-time) start) internal-time-units-per-second))))
  (format t "~D checks, ~D failures~%" *checks* *failures*)
  (zerop *failures*))
