(defun brute-max-flow (n edges s tt)
  (let ((best 0))
    (dotimes (mask (ash 1 n))
      (when (and (logbitp s mask) (not (logbitp tt mask)))
        (let ((cut (loop for (u v c) in edges
                         when (and (logbitp u mask) (not (logbitp v mask))) sum c)))
          (when (or (= mask 0) (= best 0) (< cut best)) (setf best cut)))))
    best))

