(defun naive-suffix-array (s)
  (let ((idx (loop for i below (length s) collect i)))
    (coerce (sort idx (lambda (a b)
                        (let ((x (subseq s a)) (y (subseq s b)))
                          (loop for i from 0
                                do (cond ((= i (length x)) (return (< i (length y))))
                                         ((= i (length y)) (return nil))
                                         ((/= (elt x i) (elt y i)) (return (< (elt x i) (elt y i)))))))))
            'vector)))

(defun lcp-of (s a b)
  (loop for k from 0
        while (and (< (+ a k) (length s)) (< (+ b k) (length s))
                   (= (elt s (+ a k)) (elt s (+ b k))))
        finally (return k)))

(deftest test-string
  (dotimes (iter 300)
    (let* ((n (rnd 0 (if (< iter 200) 60 400)))
           (upper (rnd 0 (if (zerop (random 2 *rng*)) 2 20)))
           (s (rnd-vector n 0 upper))
           (expected (naive-suffix-array s))
           (sa (suffix-array s upper)))
      (check (equalp sa expected))
      (check (equalp (suffix-array s) expected))
      (let ((lcp (lcp-array s sa)))
        (check (= (length lcp) (max 0 (1- n))))
        (dotimes (i (max 0 (1- n)))
          (check (= (aref lcp i) (lcp-of s (aref sa i) (aref sa (1+ i)))))))
      (let ((z (z-algorithm s)))
        (dotimes (i n)
          (check (= (aref z i) (lcp-of s 0 i)))))))
  (let* ((s "missisippi")
         (sa (suffix-array s)))
    (check (equalp sa #(9 6 4 1 0 8 7 5 3 2)))
    (check (equalp (lcp-array s sa) #(1 1 2 0 0 1 0 2 1)))
    (check (equalp (z-algorithm "abacaba") #(7 0 1 0 3 0 1)))
    (check (equalp (z-algorithm "") #()))
    (check (equalp (suffix-array "") #()))
    (check (equalp (suffix-array #(3.5 1 2)) #(1 2 0)))))

(deftest test-math
  (dotimes (iter 500)
    (let ((x (rnd -1000 1000)) (n (rnd 0 50)) (m (rnd 1 1000)))
      (check (= (pow-mod x n m) (mod (expt x n) m)))
      (when (= 1 (gcd x m))
        (let ((y (inv-mod x m)))
          (check (and (<= 0 y) (< y m) (= (mod (* x y) m) (mod 1 m))))))))
  (check (= (pow-mod 2 1000000000000 1000000007) (%check-pow 2 1000000000000 1000000007)))
  (dotimes (iter 500)
    (let* ((k (rnd 0 4))
           (ms (loop repeat k collect (rnd 1 30)))
           (rs (loop for m in ms collect (rnd -50 50))))
      (multiple-value-bind (y z) (crt rs ms)
        (let* ((l (reduce #'lcm ms :initial-value 1))
               (sol (loop for v from 0 below l
                          when (every (lambda (r m) (= (mod v m) (mod r m))) rs ms)
                            return v)))
          (if sol
              (check (and (= y sol) (= z l)))
              (check (and (= y 0) (= z 0))))))))
  (dotimes (iter 1000)
    (let ((n (rnd 0 30)) (m (rnd 1 30)) (a (rnd -50 50)) (b (rnd -50 50)))
      (check (= (floor-sum n m a b)
                (loop for i below n sum (floor (+ (* a i) b) m))))))
  (check (= (floor-sum 1000000000 1000000000 999999999 999999999)
            (+ (* (floor (* 999999999 1000000000) 2) 0)
               (%check-floor-sum 1000000000 1000000000 999999999 999999999)))))

(defun %check-pow (x n m)
  (let ((r 1) (y (mod x m)))
    (loop while (> n 0)
          do (when (oddp n) (setf r (mod (* r y) m)))
             (setf y (mod (* y y) m) n (ash n -1)))
    r))

(defun %check-floor-sum (n m a b)
  (if (= n 0)
      0
      (let ((s 0))
        (let ((q (floor a m)) (r (mod a m)))
          (incf s (* q (floor (* n (1- n)) 2)))
          (setf a r))
        (let ((q (floor b m)) (r (mod b m)))
          (incf s (* q n))
          (setf b r))
        (let ((y (+ (* a n) b)))
          (if (< y m)
              s
              (+ s (%check-floor-sum (floor y m) a m (mod y m))))))))

