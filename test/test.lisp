(defpackage :ac-library-test
  (:use :cl :ac-library)
  (:export #:run-all))

(in-package :ac-library-test)

(defvar *checks* 0)
(defvar *failures* 0)
(defvar *current* "")

(defmacro check (form)
  `(progn
     (incf *checks*)
     (unless ,form
       (incf *failures*)
       (when (<= *failures* 30)
         (format t "FAIL [~A]: ~S~%" *current* ',form)))))

(defmacro deftest (name &body body)
  `(defun ,name ()
     (setf *current* ,(string-downcase (symbol-name name)))
     ,@body))

(defvar *rng* (sb-ext:seed-random-state 20261101))

(defun rnd (lo hi)
  (+ lo (random (1+ (- hi lo)) *rng*)))

(defun rnd-vector (n lo hi)
  (let ((v (make-array n)))
    (dotimes (i n) (setf (svref v i) (rnd lo hi)))
    v))

(deftest test-dsu
  (dotimes (iter 200)
    (let* ((n (rnd 1 30))
           (d (make-dsu n))
           (label (make-array n)))
      (dotimes (i n) (setf (svref label i) i))
      (dotimes (q 60)
        (let ((a (rnd 0 (1- n))) (b (rnd 0 (1- n))))
          (if (zerop (random 2 *rng*))
              (let ((la (svref label a)) (lb (svref label b)))
                (let ((leader (dsu-merge d a b)))
                  (check (dsu-same d leader a)))
                (dotimes (i n)
                  (when (= (svref label i) lb) (setf (svref label i) la))))
              (progn
                (check (eq (dsu-same d a b) (= (svref label a) (svref label b))))
                (check (= (dsu-size d a) (count (svref label a) label)))))))
      (let ((groups (dsu-groups d)))
        (check (= n (reduce #'+ (mapcar #'length groups))))
        (dolist (g groups)
          (check (equal g (sort (copy-list g) #'<)))
          (dolist (x g) (check (= (svref label x) (svref label (first g))))))))))

