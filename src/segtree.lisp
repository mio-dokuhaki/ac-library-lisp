(in-package :ac-library)

(defstruct (segtree (:constructor %make-segtree)
                    (:conc-name %segtree-)
                    (:copier nil))
  (n 0 :type fixnum)
  (size 1 :type fixnum)
  (lg 0 :type fixnum)
  (d #() :type simple-vector)
  (op #'identity :type function)
  (e nil))

(defun make-segtree (n-or-vector &key op e)
  (assert op)
  (let* ((v (if (integerp n-or-vector)
                (make-array n-or-vector :initial-element e)
                (coerce n-or-vector 'simple-vector)))
         (n (length v))
         (size (%bit-ceil n))
         (op (coerce op 'function))
         (d (make-array (* 2 size) :initial-element e)))
    (dotimes (i n)
      (setf (svref d (+ size i)) (svref v i)))
    (loop for i from (1- size) downto 1
          do (setf (svref d i) (funcall op (svref d (* 2 i)) (svref d (1+ (* 2 i))))))
    (%make-segtree :n n :size size :lg (%countr-zero size) :d d :op op :e e)))

(defmacro %seg-update (k)
  `(let ((%k ,k))
     (declare (fixnum %k))
     (setf (svref %d %k) (%op (svref %d (* 2 %k)) (svref %d (1+ (* 2 %k)))))))

(defmacro %with-seg ((seg) &body body)
  `(let ((%d (%segtree-d ,seg))
         (%size (%segtree-size ,seg))
         (%lg (%segtree-lg ,seg))
         (%n (%segtree-n ,seg))
         (%e (%segtree-e ,seg)))
     (declare (type simple-vector %d) (fixnum %size %lg %n)
              (ignorable %d %size %lg %n %e))
     ,@body))

(defmacro %segtree-template (prefix op-expr)
  (flet ((name (suffix)
           (intern (concatenate 'string (symbol-name prefix) suffix) (symbol-package prefix))))
    `(macrolet ((%op (a b) (list 'funcall ',op-expr a b)))
       (defun ,(name "-SET") (seg p x)
         (declare (type segtree seg) (fixnum p))
         (%with-seg (seg)
           (assert (and (<= 0 p) (< p %n)))
           (incf p %size)
           (setf (svref %d p) x)
           (loop for i of-type (integer 0 62) from 1 to %lg
                 do (%seg-update (ash p (- i))))
           x))

       (defun ,(name "-GET") (seg p)
         (declare (type segtree seg) (fixnum p))
         (%with-seg (seg)
           (assert (and (<= 0 p) (< p %n)))
           (svref %d (+ p %size))))

       (defun ,(name "-PROD") (seg l r)
         (declare (type segtree seg) (fixnum l r))
         (%with-seg (seg)
           (assert (and (<= 0 l) (<= l r) (<= r %n)))
           (let ((sml %e) (smr %e))
             (incf l %size)
             (incf r %size)
             (loop while (< l r)
                   do (when (oddp l)
                        (setf sml (%op sml (svref %d l)))
                        (incf l))
                      (when (oddp r)
                        (decf r)
                        (setf smr (%op (svref %d r) smr)))
                      (setf l (ash l -1)
                            r (ash r -1)))
             (%op sml smr))))

       (defun ,(name "-ALL-PROD") (seg)
         (declare (type segtree seg))
         (svref (%segtree-d seg) 1))

       (defun ,(name "-MAX-RIGHT") (seg l f)
         (declare (type segtree seg) (fixnum l))
         (%with-seg (seg)
           (assert (and (<= 0 l) (<= l %n)))
           (assert (funcall f %e))
           (when (= l %n) (return-from ,(name "-MAX-RIGHT") %n))
           (incf l %size)
           (let ((sm %e))
             (loop
               (loop while (evenp l) do (setf l (ash l -1)))
               (unless (funcall f (%op sm (svref %d l)))
                 (loop while (< l %size)
                       do (setf l (* 2 l))
                          (let ((x (%op sm (svref %d l))))
                            (when (funcall f x)
                              (setf sm x)
                              (incf l))))
                 (return-from ,(name "-MAX-RIGHT") (- l %size)))
               (setf sm (%op sm (svref %d l)))
               (incf l)
               (when (= (logand l (- l)) l) (return)))
             %n)))

       (defun ,(name "-MIN-LEFT") (seg r f)
         (declare (type segtree seg) (fixnum r))
         (%with-seg (seg)
           (assert (and (<= 0 r) (<= r %n)))
           (assert (funcall f %e))
           (when (= r 0) (return-from ,(name "-MIN-LEFT") 0))
           (incf r %size)
           (let ((sm %e))
             (loop
               (decf r)
               (loop while (and (> r 1) (oddp r)) do (setf r (ash r -1)))
               (unless (funcall f (%op (svref %d r) sm))
                 (loop while (< r %size)
                       do (setf r (1+ (* 2 r)))
                          (let ((x (%op (svref %d r) sm)))
                            (when (funcall f x)
                              (setf sm x)
                              (decf r))))
                 (return-from ,(name "-MIN-LEFT") (- (1+ r) %size)))
               (setf sm (%op (svref %d r) sm))
               (when (= (logand r (- r)) r) (return)))
             0)))
       ',prefix)))

(%segtree-template segtree (%segtree-op seg))

(defmacro define-segtree (name &key op e)
  (flet ((sym (fmt) (intern (format nil fmt (symbol-name name)) (symbol-package name))))
    (let ((op-fn (sym "%~A-OP")))
      `(progn
         (declaim (inline ,op-fn))
         (defun ,op-fn (a b) (funcall ,op a b))
         (defun ,(sym "MAKE-~A") (n-or-vector)
           (make-segtree n-or-vector :op ,op :e ,e))
         (%segtree-template ,name #',op-fn)))))
