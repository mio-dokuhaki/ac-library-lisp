(in-package :ac-library)

(defun pow-mod (x n m)
  (assert (and (<= 0 n) (<= 1 m)))
  (%pow-mod x n m))

(defun inv-mod (x m)
  (assert (<= 1 m))
  (multiple-value-bind (g y) (%inv-gcd x m)
    (assert (= g 1) () "~S is not invertible modulo ~S" x m)
    y))

(defun crt (r m)
  (let ((r (coerce r 'simple-vector))
        (m (coerce m 'simple-vector))
        (r0 0)
        (m0 1))
    (assert (= (length r) (length m)))
    (dotimes (i (length r))
      (assert (<= 1 (svref m i)))
      (let ((r1 (mod (svref r i) (svref m i)))
            (m1 (svref m i)))
        (when (< m0 m1)
          (rotatef r0 r1)
          (rotatef m0 m1))
        (if (zerop (mod m0 m1))
            (unless (= (mod r0 m1) r1)
              (return-from crt (values 0 0)))
            (multiple-value-bind (g im) (%inv-gcd m0 m1)
              (let ((u1 (floor m1 g)))
                (unless (zerop (mod (- r1 r0) g))
                  (return-from crt (values 0 0)))
                (let ((x (mod (* (mod (floor (- r1 r0) g) u1) im) u1)))
                  (incf r0 (* x m0))
                  (setf m0 (* m0 u1))
                  (setf r0 (mod r0 m0))))))))
    (values r0 m0)))

(defun %floor-sum-unsigned (n m a b)
  (let ((ans 0))
    (loop
      (when (>= a m)
        (incf ans (* (floor (* n (1- n)) 2) (floor a m)))
        (setf a (mod a m)))
      (when (>= b m)
        (incf ans (* n (floor b m)))
        (setf b (mod b m)))
      (let ((y-max (+ (* a n) b)))
        (when (< y-max m) (return))
        (setf n (floor y-max m)
              b (mod y-max m))
        (rotatef m a)))
    ans))

(defun floor-sum (n m a b)
  (assert (and (<= 0 n) (<= 1 m)))
  (let ((ans 0))
    (when (< a 0)
      (let ((a2 (mod a m)))
        (decf ans (* (floor (* n (1- n)) 2) (floor (- a2 a) m)))
        (setf a a2)))
    (when (< b 0)
      (let ((b2 (mod b m)))
        (decf ans (* n (floor (- b2 b) m)))
        (setf b b2)))
    (+ ans (%floor-sum-unsigned n m a b))))
