(in-package :ac-library)

(defun %sa-naive (s)
  (declare (type %index-vector s))
  (let* ((n (length s))
         (sa (%make-index-vector n)))
    (dotimes (i n) (setf (aref sa i) i))
    (sort sa (lambda (l r)
               (if (= l r)
                   nil
                   (loop
                     (when (or (= l n) (= r n)) (return (= l n)))
                     (when (/= (aref s l) (aref s r))
                       (return (< (aref s l) (aref s r))))
                     (incf l)
                     (incf r)))))))

(defun %sa-doubling (s)
  (declare (type %index-vector s))
  (let* ((n (length s))
         (sa (%make-index-vector n))
         (rnk (copy-seq s))
         (tmp (%make-index-vector n)))
    (dotimes (i n) (setf (aref sa i) i))
    (loop for k = 1 then (* k 2)
          while (< k n)
          do (flet ((cmp (x y)
                      (if (/= (aref rnk x) (aref rnk y))
                          (< (aref rnk x) (aref rnk y))
                          (< (if (< (+ x k) n) (aref rnk (+ x k)) -1)
                             (if (< (+ y k) n) (aref rnk (+ y k)) -1)))))
               (setf sa (sort sa #'cmp))
               (setf (aref tmp (aref sa 0)) 0)
               (loop for i from 1 below n
                     do (setf (aref tmp (aref sa i))
                              (+ (aref tmp (aref sa (1- i)))
                                 (if (cmp (aref sa (1- i)) (aref sa i)) 1 0))))
               (rotatef tmp rnk)))
    sa))

(defun %sa-is (s upper)
  (declare (type %index-vector s) (fixnum upper))
  (let ((n (length s)))
    (cond
      ((= n 0) (%make-index-vector 0))
      ((= n 1) (%make-index-vector 1 0))
      ((= n 2)
       (let ((sa (%make-index-vector 2)))
         (if (< (aref s 0) (aref s 1))
             (setf (aref sa 0) 0 (aref sa 1) 1)
             (setf (aref sa 0) 1 (aref sa 1) 0))
         sa))
      ((< n 10) (%sa-naive s))
      ((< n 40) (%sa-doubling s))
      (t
       (let ((sa (%make-index-vector n -1))
             (ls (make-array n :element-type 'bit :initial-element 0))
             (sum-l (%make-index-vector (1+ upper)))
             (sum-s (%make-index-vector (1+ upper))))
         (loop for i from (- n 2) downto 0
               do (setf (aref ls i)
                        (if (= (aref s i) (aref s (1+ i)))
                            (aref ls (1+ i))
                            (if (< (aref s i) (aref s (1+ i))) 1 0))))
         (dotimes (i n)
           (if (zerop (aref ls i))
               (incf (aref sum-s (aref s i)))
               (incf (aref sum-l (1+ (aref s i))))))
         (loop for i from 0 to upper
               do (incf (aref sum-s i) (aref sum-l i))
                  (when (< i upper)
                    (incf (aref sum-l (1+ i)) (aref sum-s i))))
         (flet ((induce (lms)
                  (declare (type %index-vector lms))
                  (fill sa -1)
                  (let ((buf (copy-seq sum-s)))
                    (loop for d across lms
                          do (unless (= d n)
                               (setf (aref sa (aref buf (aref s d))) d)
                               (incf (aref buf (aref s d)))))
                    (replace buf sum-l)
                    (setf (aref sa (aref buf (aref s (1- n)))) (1- n))
                    (incf (aref buf (aref s (1- n))))
                    (dotimes (i n)
                      (let ((v (aref sa i)))
                        (when (and (>= v 1) (zerop (aref ls (1- v))))
                          (setf (aref sa (aref buf (aref s (1- v)))) (1- v))
                          (incf (aref buf (aref s (1- v)))))))
                    (replace buf sum-l)
                    (loop for i from (1- n) downto 0
                          do (let ((v (aref sa i)))
                               (when (and (>= v 1) (= 1 (aref ls (1- v))))
                                 (let ((c (1+ (aref s (1- v)))))
                                   (decf (aref buf c))
                                   (setf (aref sa (aref buf c)) (1- v)))))))))
           (let ((lms-map (%make-index-vector (1+ n) -1))
                 (m 0))
             (loop for i from 1 below n
                   do (when (and (zerop (aref ls (1- i))) (= 1 (aref ls i)))
                        (setf (aref lms-map i) m)
                        (incf m)))
             (let ((lms (%make-index-vector m))
                   (k 0))
               (loop for i from 1 below n
                     do (when (and (zerop (aref ls (1- i))) (= 1 (aref ls i)))
                          (setf (aref lms k) i)
                          (incf k)))
               (induce lms)
               (when (> m 0)
                 (let ((sorted-lms (%make-index-vector m))
                       (k 0)
                       (rec-s (%make-index-vector m))
                       (rec-upper 0))
                   (loop for v across sa
                         do (when (/= (aref lms-map v) -1)
                              (setf (aref sorted-lms k) v)
                              (incf k)))
                   (setf (aref rec-s (aref lms-map (aref sorted-lms 0))) 0)
                   (loop for i from 1 below m
                         do (let* ((l (aref sorted-lms (1- i)))
                                   (r (aref sorted-lms i))
                                   (end-l (if (< (1+ (aref lms-map l)) m)
                                              (aref lms (1+ (aref lms-map l)))
                                              n))
                                   (end-r (if (< (1+ (aref lms-map r)) m)
                                              (aref lms (1+ (aref lms-map r)))
                                              n))
                                   (same t))
                              (if (/= (- end-l l) (- end-r r))
                                  (setf same nil)
                                  (progn
                                    (loop while (and (< l end-l) (= (aref s l) (aref s r)))
                                          do (incf l)
                                             (incf r))
                                    (when (or (= l n) (= r n) (/= (aref s l) (aref s r)))
                                      (setf same nil))))
                              (unless same (incf rec-upper))
                              (setf (aref rec-s (aref lms-map (aref sorted-lms i))) rec-upper)))
                   (let ((rec-sa (%sa-is rec-s rec-upper)))
                     (dotimes (i m)
                       (setf (aref sorted-lms i) (aref lms (aref rec-sa i)))))
                   (induce sorted-lms))))))
         sa)))))

(defun %element< (a b)
  (cond ((and (realp a) (realp b)) (< a b))
        ((and (characterp a) (characterp b)) (char< a b))
        ((and (stringp a) (stringp b)) (and (string< a b) t))
        (t (error "Cannot compare ~S and ~S" a b))))

(defun %element= (a b)
  (cond ((and (numberp a) (numberp b)) (= a b))
        ((and (characterp a) (characterp b)) (char= a b))
        (t (equal a b))))

(defun %string-codes (s)
  (let ((v (%make-index-vector (length s))))
    (dotimes (i (length s))
      (setf (aref v i) (char-code (char s i))))
    v))

(defun %compress (s)
  (let* ((n (length s))
         (v (coerce s 'simple-vector))
         (idx (%make-index-vector n))
         (s2 (%make-index-vector n))
         (now 0))
    (dotimes (i n) (setf (aref idx i) i))
    (setf idx (sort idx (lambda (l r) (%element< (svref v l) (svref v r)))))
    (dotimes (i n)
      (when (and (> i 0)
                 (not (%element= (svref v (aref idx (1- i))) (svref v (aref idx i)))))
        (incf now))
      (setf (aref s2 (aref idx i)) now))
    (values s2 now)))

(defun suffix-array (s &optional upper)
  (cond
    (upper
     (assert (<= 0 upper))
     (let ((v (coerce s '%index-vector)))
       (loop for d across v do (assert (<= 0 d upper)))
       (%sa-is v upper)))
    ((stringp s)
     (let ((v (%string-codes s)))
       (%sa-is v (reduce #'max v :initial-value 0))))
    (t
     (multiple-value-bind (v up) (%compress s)
       (%sa-is v up)))))

(defun %as-comparable (s)
  (if (stringp s) (%string-codes s) (coerce s 'simple-vector)))

(defun lcp-array (s sa)
  (let* ((v (%as-comparable s))
         (n (length v)))
    (when (= n 0) (return-from lcp-array (%make-index-vector 0)))
    (let ((rnk (%make-index-vector n))
          (lcp (%make-index-vector (1- n)))
          (h 0))
      (dotimes (i n)
        (setf (aref rnk (aref sa i)) i))
      (dotimes (i n)
        (when (> h 0) (decf h))
        (unless (= (aref rnk i) 0)
          (let ((j (aref sa (1- (aref rnk i)))))
            (loop while (and (< (+ j h) n) (< (+ i h) n)
                             (%element= (aref v (+ j h)) (aref v (+ i h))))
                  do (incf h))
            (setf (aref lcp (1- (aref rnk i))) h))))
      lcp)))

(defun z-algorithm (s)
  (let* ((v (%as-comparable s))
         (n (length v))
         (z (%make-index-vector n)))
    (when (= n 0) (return-from z-algorithm z))
    (let ((j 0))
      (loop for i from 1 below n
            do (let ((k (if (<= (+ j (aref z j)) i)
                            0
                            (min (- (+ j (aref z j)) i) (aref z (- i j))))))
                 (loop while (and (< (+ i k) n) (%element= (aref v k) (aref v (+ i k))))
                       do (incf k))
                 (setf (aref z i) k)
                 (when (< (+ j (aref z j)) (+ i (aref z i)))
                   (setf j i)))))
    (setf (aref z 0) n)
    z))
