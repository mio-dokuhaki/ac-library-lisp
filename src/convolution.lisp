(in-package :ac-library)

(deftype %u32-vector () '(simple-array (unsigned-byte 32) (*)))

(defun %ntt (a m g invert)
  (declare (type %u32-vector a)
           (type (unsigned-byte 31) m g)
           (optimize (speed 3) (safety 0))
           #+sbcl (sb-ext:muffle-conditions sb-ext:compiler-note))
  (let* ((n (length a))
         (ws (make-array (max 1 (ash n -1)) :element-type '(unsigned-byte 32))))
    (declare (fixnum n) (type %u32-vector ws))
    (let ((j 0))
      (declare (fixnum j))
      (loop for i fixnum from 1 below n
            do (let ((bit (ash n -1)))
                 (declare (fixnum bit))
                 (loop while (/= 0 (logand j bit))
                       do (setf j (logxor j bit)
                                bit (ash bit -1)))
                 (setf j (logxor j bit))
                 (when (< i j)
                   (rotatef (aref a i) (aref a j))))))
    (let ((len 2))
      (declare (fixnum len))
      (loop while (<= len n)
            do (let* ((w (%pow-mod g (floor (1- m) len) m))
                      (w (if invert (%pow-mod w (- m 2) m) w))
                      (half (ash len -1)))
                 (declare (type (unsigned-byte 31) w) (fixnum half))
                 (setf (aref ws 0) 1)
                 (loop for k fixnum from 1 below half
                       do (setf (aref ws k) (mod (* (aref ws (1- k)) w) m)))
                 (loop for i fixnum from 0 below n by len
                       do (loop for k fixnum from 0 below half
                                do (let* ((u (aref a (+ i k)))
                                          (v (mod (* (aref a (+ i k half)) (aref ws k)) m))
                                          (x (+ u v))
                                          (y (- u v)))
                                     (declare (type (unsigned-byte 32) u v))
                                     (setf (aref a (+ i k)) (if (>= x m) (- x m) x)
                                           (aref a (+ i k half)) (if (< y 0) (+ y m) y)))))
                 (setf len (* len 2)))))
    (when invert
      (let ((ninv (%pow-mod n (- m 2) m)))
        (declare (type (unsigned-byte 31) ninv))
        (dotimes (i n)
          (setf (aref a i) (mod (* (aref a i) ninv) m)))))
    a))

(defun %to-u32-mod (a m)
  (let ((v (make-array (length a) :element-type '(unsigned-byte 32))))
    (map-into v (lambda (x) (mod x m)) a)))

(defun %convolution-mod (a b m)
  (declare (type %u32-vector a b))
  (let ((n (length a))
        (k (length b)))
    (when (or (= n 0) (= k 0))
      (return-from %convolution-mod (make-array 0 :element-type '(unsigned-byte 32))))
    (if (<= (min n k) 60)
        (let ((ans (make-array (+ n k -1) :element-type '(unsigned-byte 32) :initial-element 0)))
          (dotimes (i n)
            (dotimes (j k)
              (setf (aref ans (+ i j))
                    (mod (+ (aref ans (+ i j)) (* (aref a i) (aref b j))) m))))
          ans)
        (let* ((len (+ n k -1))
               (z (%bit-ceil len))
               (g (%primitive-root m))
               (fa (make-array z :element-type '(unsigned-byte 32) :initial-element 0))
               (fb (make-array z :element-type '(unsigned-byte 32) :initial-element 0)))
          (assert (zerop (mod (1- m) z)) () "Modulus ~S does not support length ~S" m z)
          (replace fa a)
          (replace fb b)
          (%ntt fa m g nil)
          (%ntt fb m g nil)
          (dotimes (i z)
            (setf (aref fa i) (mod (* (aref fa i) (aref fb i)) m)))
          (%ntt fa m g t)
          (subseq fa 0 len)))))

(defun convolution (a b &optional (m 998244353))
  (assert (and (%prime-p m) (< m (expt 2 31))))
  (let ((c (%convolution-mod (%to-u32-mod a m) (%to-u32-mod b m) m)))
    (coerce c '%index-vector)))

(defun convolution-ll (a b)
  (let ((n (length a))
        (k (length b)))
    (when (or (= n 0) (= k 0))
      (return-from convolution-ll (vector)))
    (if (<= (min n k) 60)
        (let ((ans (make-array (+ n k -1) :initial-element 0))
              (a (coerce a 'simple-vector))
              (b (coerce b 'simple-vector)))
          (dotimes (i n)
            (dotimes (j k)
              (incf (svref ans (+ i j)) (* (svref a i) (svref b j)))))
          ans)
        (let* ((m1 754974721)
               (m2 167772161)
               (m3 469762049)
               (c1 (%convolution-mod (%to-u32-mod a m1) (%to-u32-mod b m1) m1))
               (c2 (%convolution-mod (%to-u32-mod a m2) (%to-u32-mod b m2) m2))
               (c3 (%convolution-mod (%to-u32-mod a m3) (%to-u32-mod b m3) m3))
               (m1m2 (* m1 m2))
               (all (* m1m2 m3))
               (half (floor all 2))
               (i1 (nth-value 1 (%inv-gcd m1 m2)))
               (i12 (nth-value 1 (%inv-gcd m1m2 m3)))
               (len (+ n k -1))
               (ans (make-array len)))
          (dotimes (i len)
            (let* ((x1 (aref c1 i))
                   (x2 (mod (* (- (aref c2 i) x1) i1) m2))
                   (x3 (mod (* (- (aref c3 i) x1 (* x2 m1)) i12) m3))
                   (x (+ x1 (* x2 m1) (* x3 m1m2))))
              (setf (svref ans i) (if (> x half) (- x all) x))))
          ans))))
