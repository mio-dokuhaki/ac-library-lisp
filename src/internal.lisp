(in-package :ac-library)

(deftype %index-vector () '(simple-array fixnum (*)))

(defun %bit-ceil (n)
  (let ((x 1))
    (loop while (< x n) do (setf x (* x 2)))
    x))

(defun %countr-zero (n)
  (1- (integer-length (logand n (- n)))))

(defun %pow-mod (x n m)
  (if (= m 1)
      0
      (let ((r 1) (y (mod x m)))
        (loop while (> n 0)
              do (when (oddp n) (setf r (mod (* r y) m)))
                 (setf y (mod (* y y) m)
                       n (ash n -1)))
        r)))

(defun %prime-p (n)
  (cond ((<= n 1) nil)
        ((<= n 3) t)
        ((evenp n) nil)
        (t
         (let ((d (1- n)) (s 0))
           (loop while (evenp d) do (setf d (ash d -1)) (incf s))
           (dolist (a '(2 325 9375 28178 450775 9780504 1795265022) t)
             (let ((a (mod a n)))
               (unless (zerop a)
                 (let ((y (%pow-mod a d n)))
                   (unless (or (= y 1) (= y (1- n)))
                     (unless (loop repeat (1- s)
                                   do (setf y (mod (* y y) n))
                                   thereis (= y (1- n)))
                       (return nil)))))))))))

(defun %inv-gcd (a b)
  (let ((a (mod a b)))
    (if (zerop a)
        (values b 0)
        (let ((s b) (tt a) (m0 0) (m1 1))
          (loop while (/= tt 0)
                do (let ((u (floor s tt)))
                     (decf s (* tt u))
                     (decf m0 (* m1 u))
                     (rotatef s tt)
                     (rotatef m0 m1)))
          (when (< m0 0) (incf m0 (floor b s)))
          (values s m0)))))

(defun %primitive-root (m)
  (case m
    (2 1)
    (167772161 3)
    (469762049 3)
    (754974721 11)
    (998244353 3)
    (t
     (let ((divs (list 2)) (x (floor (1- m) 2)))
       (loop while (and (> x 0) (evenp x)) do (setf x (ash x -1)))
       (loop for i from 3 by 2
             while (<= (* i i) x)
             do (when (zerop (mod x i))
                  (push i divs)
                  (loop while (zerop (mod x i)) do (setf x (floor x i)))))
       (when (> x 1) (push x divs))
       (loop for g from 2
             when (every (lambda (d) (/= (%pow-mod g (floor (1- m) d) m) 1)) divs)
               return g)))))

(defun %make-index-vector (n &optional (initial 0))
  (make-array n :element-type 'fixnum :initial-element initial))

(defun %make-growing-vector ()
  (make-array 0 :adjustable t :fill-pointer 0))

(defun %csr (n from to)
  (let* ((m (length from))
         (start (%make-index-vector (1+ n)))
         (elist (%make-index-vector m)))
    (dotimes (i m)
      (incf (aref start (1+ (aref from i)))))
    (loop for i from 1 to n
          do (incf (aref start i) (aref start (1- i))))
    (let ((counter (copy-seq start)))
      (dotimes (i m)
        (let ((f (aref from i)))
          (setf (aref elist (aref counter f)) (aref to i))
          (incf (aref counter f)))))
    (values start elist)))

(defun %scc-ids (n start elist)
  (declare (type %index-vector start elist) (fixnum n))
  (let ((now-ord 0)
        (group-num 0)
        (visited (%make-index-vector n))
        (vsize 0)
        (callstack (%make-index-vector n))
        (csize 0)
        (it (%make-index-vector n))
        (low (%make-index-vector n))
        (ord (%make-index-vector n -1))
        (ids (%make-index-vector n)))
    (declare (fixnum now-ord group-num vsize csize))
    (dotimes (root n)
      (when (< (aref ord root) 0)
        (setf (aref ord root) now-ord
              (aref low root) now-ord
              (aref it root) (aref start root)
              (aref visited vsize) root
              (aref callstack csize) root)
        (incf now-ord)
        (incf vsize)
        (incf csize)
        (loop while (> csize 0)
              do (let ((v (aref callstack (1- csize))))
                   (if (< (aref it v) (aref start (1+ v)))
                       (let ((to (aref elist (aref it v))))
                         (incf (aref it v))
                         (if (< (aref ord to) 0)
                             (progn
                               (setf (aref ord to) now-ord
                                     (aref low to) now-ord
                                     (aref it to) (aref start to)
                                     (aref visited vsize) to
                                     (aref callstack csize) to)
                               (incf now-ord)
                               (incf vsize)
                               (incf csize))
                             (setf (aref low v) (min (aref low v) (aref ord to)))))
                       (progn
                         (decf csize)
                         (when (= (aref low v) (aref ord v))
                           (loop
                             (decf vsize)
                             (let ((u (aref visited vsize)))
                               (setf (aref ord u) n
                                     (aref ids u) group-num)
                               (when (= u v) (return))))
                           (incf group-num))
                         (when (> csize 0)
                           (let ((p (aref callstack (1- csize))))
                             (setf (aref low p) (min (aref low p) (aref low v)))))))))))
    (dotimes (i n)
      (setf (aref ids i) (- group-num 1 (aref ids i))))
    (values group-num ids)))
