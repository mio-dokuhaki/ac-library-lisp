(in-package :ac-library)

(defstruct (mcf-edge (:constructor %make-mcf-edge (from to cap flow cost)))
  from to cap flow cost)

(defstruct (mcf-graph (:constructor %make-mcf-graph (n edges))
                      (:conc-name %mcf-)
                      (:copier nil))
  (n 0 :type fixnum)
  edges)

(defun make-mcf-graph (n)
  (assert (<= 0 n))
  (%make-mcf-graph n (%make-growing-vector)))

(defun mcf-graph-add-edge (graph from to cap cost)
  (let ((n (%mcf-n graph)))
    (assert (and (<= 0 from) (< from n) (<= 0 to) (< to n) (<= 0 cap) (<= 0 cost)))
    (let ((m (fill-pointer (%mcf-edges graph))))
      (vector-push-extend (%make-mcf-edge from to cap 0 cost) (%mcf-edges graph))
      m)))

(defun mcf-graph-get-edge (graph i)
  (let ((edges (%mcf-edges graph)))
    (assert (and (<= 0 i) (< i (fill-pointer edges))))
    (copy-mcf-edge (aref edges i))))

(defun mcf-graph-edges (graph)
  (loop for e across (%mcf-edges graph)
        collect (copy-mcf-edge e)))

(defun mcf-graph-flow (graph s tt &optional flow-limit)
  (let ((last (car (last (mcf-graph-slope graph s tt flow-limit)))))
    (values (car last) (cdr last))))

(defun mcf-graph-slope (graph s tt &optional flow-limit)
  (let ((n (%mcf-n graph))
        (edges (%mcf-edges graph)))
    (assert (and (<= 0 s) (< s n) (<= 0 tt) (< tt n) (/= s tt)))
    (let* ((m (fill-pointer edges))
           (eto (%make-index-vector (* 2 m)))
           (ecap (make-array (* 2 m)))
           (ecost (make-array (* 2 m)))
           (efrom (%make-index-vector (* 2 m)))
           (ids (%make-index-vector (* 2 m))))
      (dotimes (i m)
        (let ((e (aref edges i))
              (f (* 2 i))
              (b (1+ (* 2 i))))
          (setf (aref efrom f) (mcf-edge-from e)
                (aref eto f) (mcf-edge-to e)
                (svref ecap f) (- (mcf-edge-cap e) (mcf-edge-flow e))
                (svref ecost f) (mcf-edge-cost e)
                (aref ids f) f
                (aref efrom b) (mcf-edge-to e)
                (aref eto b) (mcf-edge-from e)
                (svref ecap b) (mcf-edge-flow e)
                (svref ecost b) (- (mcf-edge-cost e))
                (aref ids b) b)))
      (multiple-value-bind (start elist) (%csr n efrom ids)
        (let ((dual (make-array n :initial-element 0))
              (dist (make-array n :initial-element nil))
              (prev-e (%make-index-vector n))
              (vis (make-array n :initial-element nil))
              (hk (%make-growing-vector))
              (hv (%make-growing-vector)))
          (labels ((heap-push (k v)
                     (vector-push-extend k hk)
                     (vector-push-extend v hv)
                     (let ((i (1- (fill-pointer hk))))
                       (loop while (> i 0)
                             do (let ((p (ash (1- i) -1)))
                                  (if (< (aref hk i) (aref hk p))
                                      (progn
                                        (rotatef (aref hk i) (aref hk p))
                                        (rotatef (aref hv i) (aref hv p))
                                        (setf i p))
                                      (return))))))
                   (heap-pop ()
                     (let ((v (aref hv 0))
                           (last (1- (fill-pointer hk))))
                       (setf (aref hk 0) (aref hk last)
                             (aref hv 0) (aref hv last))
                       (decf (fill-pointer hk))
                       (decf (fill-pointer hv))
                       (let ((i 0) (size last))
                         (loop
                           (let* ((l (1+ (* 2 i)))
                                  (r (1+ l))
                                  (best i))
                             (when (and (< l size) (< (aref hk l) (aref hk best))) (setf best l))
                             (when (and (< r size) (< (aref hk r) (aref hk best))) (setf best r))
                             (when (= best i) (return))
                             (rotatef (aref hk i) (aref hk best))
                             (rotatef (aref hv i) (aref hv best))
                             (setf i best))))
                       v))
                   (dual-ref ()
                     (fill dist nil)
                     (fill vis nil)
                     (setf (fill-pointer hk) 0
                           (fill-pointer hv) 0)
                     (setf (svref dist s) 0)
                     (heap-push 0 s)
                     (loop while (> (fill-pointer hk) 0)
                           do (let ((v (heap-pop)))
                                (unless (svref vis v)
                                  (setf (svref vis v) t)
                                  (when (= v tt) (return))
                                  (let ((dual-v (svref dual v))
                                        (dist-v (svref dist v)))
                                    (loop for k from (aref start v) below (aref start (1+ v))
                                          do (let ((id (aref elist k)))
                                               (when (> (svref ecap id) 0)
                                                 (let* ((to (aref eto id))
                                                        (cost (+ (- (svref ecost id) (svref dual to)) dual-v)))
                                                   (when (or (null (svref dist to))
                                                             (> (- (svref dist to) dist-v) cost))
                                                     (let ((dist-to (+ dist-v cost)))
                                                       (setf (svref dist to) dist-to
                                                             (aref prev-e to) (logxor id 1))
                                                       (heap-push dist-to to)))))))))))
                     (unless (svref vis tt)
                       (return-from dual-ref nil))
                     (dotimes (v n)
                       (when (svref vis v)
                         (decf (svref dual v) (- (svref dist tt) (svref dist v)))))
                     t))
            (let ((flow 0)
                  (cost 0)
                  (prev-cost-per-flow -1)
                  (result (list (cons 0 0))))
              (loop while (or (null flow-limit) (< flow flow-limit))
                    do (unless (dual-ref) (return))
                       (let ((c (and flow-limit (- flow-limit flow))))
                         (let ((v tt))
                           (loop while (/= v s)
                                 do (let* ((re (aref prev-e v))
                                           (cap (svref ecap (logxor re 1))))
                                      (when (or (null c) (< cap c)) (setf c cap))
                                      (setf v (aref eto re)))))
                         (let ((v tt))
                           (loop while (/= v s)
                                 do (let ((re (aref prev-e v)))
                                      (incf (svref ecap re) c)
                                      (decf (svref ecap (logxor re 1)) c)
                                      (setf v (aref eto re)))))
                         (let ((d (- (svref dual s))))
                           (incf flow c)
                           (incf cost (* c d))
                           (when (= prev-cost-per-flow d)
                             (pop result))
                           (push (cons flow cost) result)
                           (setf prev-cost-per-flow d))))
              (dotimes (i m)
                (let ((e (aref edges i)))
                  (setf (mcf-edge-flow e) (- (mcf-edge-cap e) (svref ecap (* 2 i))))))
              (nreverse result))))))))
