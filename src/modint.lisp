(in-package :ac-library)

(eval-when (:compile-toplevel :load-toplevel :execute)
  (defun %modint-name (name format-string)
    (intern (format nil format-string (symbol-name name)) (symbol-package name))))

(defmacro define-modint (name modulus)
  (assert (and (integerp modulus) (<= 1 modulus)))
  (let ((m modulus)
        (add (%modint-name name "~A+"))
        (sub (%modint-name name "~A-"))
        (mul (%modint-name name "~A*"))
        (div (%modint-name name "~A/"))
        (pw (%modint-name name "~A-POW"))
        (inv (%modint-name name "~A-INV"))
        (md (%modint-name name "~A-MOD")))
    `(progn
       (deftype ,name () '(integer 0 (,m)))
       (declaim (inline ,name ,add ,sub ,mul ,pw ,md))
       (defun ,name (x) (mod x ,m))
       (defun ,md () ,m)
       (defun ,add (a b)
         (declare (type (integer 0 (,m)) a b))
         (let ((c (+ a b))) (if (>= c ,m) (- c ,m) c)))
       (defun ,sub (a b)
         (declare (type (integer 0 (,m)) a b))
         (let ((c (- a b))) (if (< c 0) (+ c ,m) c)))
       (defun ,mul (a b)
         (declare (type (integer 0 (,m)) a b))
         (mod (* a b) ,m))
       (defun ,pw (a e)
         (declare (type (integer 0 (,m)) a) (type (integer 0) e))
         (let ((r (mod 1 ,m)))
           (loop while (> e 0)
                 do (when (oddp e) (setf r (mod (* r a) ,m)))
                    (setf a (mod (* a a) ,m)
                          e (ash e -1)))
           r))
       (defun ,inv (a)
         (multiple-value-bind (g x) (%inv-gcd a ,m)
           (assert (= g 1) () "~S is not invertible modulo ~S" a ,m)
           x))
       (defun ,div (a b)
         (,mul a (,inv b)))
       ',name)))

(defmacro define-dynamic-modint (name &optional (default 998244353))
  (let ((var (%modint-name name "*~A-MODULUS*"))
        (add (%modint-name name "~A+"))
        (sub (%modint-name name "~A-"))
        (mul (%modint-name name "~A*"))
        (div (%modint-name name "~A/"))
        (pw (%modint-name name "~A-POW"))
        (inv (%modint-name name "~A-INV"))
        (md (%modint-name name "~A-MOD"))
        (setmod (%modint-name name "~A-SET-MOD")))
    `(progn
       (deftype ,name () '(integer 0))
       (defvar ,var ,default)
       (declaim (inline ,name ,add ,sub ,mul ,md))
       (defun ,setmod (m)
         (assert (and (integerp m) (<= 1 m)))
         (setf ,var m))
       (defun ,md () ,var)
       (defun ,name (x) (mod x ,var))
       (defun ,add (a b)
         (let ((c (+ a b))) (if (>= c ,var) (- c ,var) c)))
       (defun ,sub (a b)
         (let ((c (- a b))) (if (< c 0) (+ c ,var) c)))
       (defun ,mul (a b)
         (mod (* a b) ,var))
       (defun ,pw (a e)
         (assert (<= 0 e))
         (%pow-mod a e ,var))
       (defun ,inv (a)
         (multiple-value-bind (g x) (%inv-gcd a ,var)
           (assert (= g 1) () "~S is not invertible modulo ~S" a ,var)
           x))
       (defun ,div (a b)
         (,mul a (,inv b)))
       ',name)))

(define-modint modint998244353 998244353)
(define-modint modint1000000007 1000000007)
(define-dynamic-modint modint)
