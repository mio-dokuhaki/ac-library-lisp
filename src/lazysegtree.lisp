(in-package :ac-library)

(defstruct (lazy-segtree (:constructor %make-lazy-segtree)
                         (:conc-name %lseg-)
                         (:copier nil))
  (n 0 :type fixnum)
  (size 1 :type fixnum)
  (lg 0 :type fixnum)
  (d #() :type simple-vector)
  (lz #() :type simple-vector)
  (op #'identity :type function)
  (e nil)
  (mapping #'identity :type function)
  (composition #'identity :type function)
  (id nil))

(defun make-lazy-segtree (n-or-vector &key op e mapping composition id)
  (assert (and op mapping composition))
  (let* ((v (if (integerp n-or-vector)
                (make-array n-or-vector :initial-element e)
                (coerce n-or-vector 'simple-vector)))
         (n (length v))
         (size (%bit-ceil n))
         (op (coerce op 'function))
         (d (make-array (* 2 size) :initial-element e)))
    (dotimes (i n)
      (setf (svref d (+ size i)) (svref v i)))
    (loop for i from (1- size) downto 1
          do (setf (svref d i) (funcall op (svref d (* 2 i)) (svref d (1+ (* 2 i))))))
    (%make-lazy-segtree :n n
                        :size size
                        :lg (%countr-zero size)
                        :d d
                        :lz (make-array size :initial-element id)
                        :op op
                        :e e
                        :mapping (coerce mapping 'function)
                        :composition (coerce composition 'function)
                        :id id)))

(defmacro %lseg-update (k)
  `(let ((%k ,k))
     (declare (fixnum %k))
     (setf (svref %d %k) (%op (svref %d (* 2 %k)) (svref %d (1+ (* 2 %k)))))))

(defmacro %lseg-all-apply (k f)
  `(let ((%k ,k) (%f ,f))
     (declare (fixnum %k))
     (setf (svref %d %k) (%mapping %f (svref %d %k)))
     (when (< %k %size)
       (setf (svref %lz %k) (%composition %f (svref %lz %k))))))

(defmacro %lseg-push (k)
  `(let* ((%pk ,k) (%pf (svref %lz %pk)))
     (declare (fixnum %pk))
     (unless (eql %pf %id)
       (%lseg-all-apply (* 2 %pk) %pf)
       (%lseg-all-apply (1+ (* 2 %pk)) %pf)
       (setf (svref %lz %pk) %id))))

(defmacro %with-lseg ((seg) &body body)
  `(let ((%d (%lseg-d ,seg))
         (%lz (%lseg-lz ,seg))
         (%size (%lseg-size ,seg))
         (%lg (%lseg-lg ,seg))
         (%n (%lseg-n ,seg))
         (%e (%lseg-e ,seg))
         (%id (%lseg-id ,seg)))
     (declare (type simple-vector %d %lz) (fixnum %size %lg %n)
              (ignorable %d %lz %size %lg %n %e %id))
     ,@body))

(defmacro %lazy-segtree-template (prefix op-expr mapping-expr composition-expr)
  (flet ((name (suffix)
           (intern (concatenate 'string (symbol-name prefix) suffix) (symbol-package prefix))))
    `(macrolet ((%op (a b) (list 'funcall ',op-expr a b))
                (%mapping (f x) (list 'funcall ',mapping-expr f x))
                (%composition (f g) (list 'funcall ',composition-expr f g)))
       (defun ,(name "-SET") (seg p x)
         (declare (type lazy-segtree seg) (fixnum p))
         (%with-lseg (seg)
           (assert (and (<= 0 p) (< p %n)))
           (incf p %size)
           (loop for i of-type (integer 0 62) from %lg downto 1
                 do (%lseg-push (ash p (- i))))
           (setf (svref %d p) x)
           (loop for i of-type (integer 0 62) from 1 to %lg
                 do (%lseg-update (ash p (- i))))
           x))

       (defun ,(name "-GET") (seg p)
         (declare (type lazy-segtree seg) (fixnum p))
         (%with-lseg (seg)
           (assert (and (<= 0 p) (< p %n)))
           (incf p %size)
           (loop for i of-type (integer 0 62) from %lg downto 1
                 do (%lseg-push (ash p (- i))))
           (svref %d p)))

       (defun ,(name "-PROD") (seg l r)
         (declare (type lazy-segtree seg) (fixnum l r))
         (%with-lseg (seg)
           (assert (and (<= 0 l) (<= l r) (<= r %n)))
           (if (= l r)
               %e
               (progn
                 (incf l %size)
                 (incf r %size)
                 (loop for i of-type (integer 0 62) from %lg downto 1
                       do (unless (= (ash (ash l (- i)) i) l) (%lseg-push (ash l (- i))))
                          (unless (= (ash (ash r (- i)) i) r) (%lseg-push (ash (1- r) (- i)))))
                 (let ((sml %e) (smr %e))
                   (loop while (< l r)
                         do (when (oddp l)
                              (setf sml (%op sml (svref %d l)))
                              (incf l))
                            (when (oddp r)
                              (decf r)
                              (setf smr (%op (svref %d r) smr)))
                            (setf l (ash l -1)
                                  r (ash r -1)))
                   (%op sml smr))))))

       (defun ,(name "-ALL-PROD") (seg)
         (declare (type lazy-segtree seg))
         (svref (%lseg-d seg) 1))

       (defun ,(name "-APPLY-AT") (seg p f)
         (declare (type lazy-segtree seg) (fixnum p))
         (%with-lseg (seg)
           (assert (and (<= 0 p) (< p %n)))
           (incf p %size)
           (loop for i of-type (integer 0 62) from %lg downto 1
                 do (%lseg-push (ash p (- i))))
           (setf (svref %d p) (%mapping f (svref %d p)))
           (loop for i of-type (integer 0 62) from 1 to %lg
                 do (%lseg-update (ash p (- i))))
           seg))

       (defun ,(name "-APPLY") (seg l r f)
         (declare (type lazy-segtree seg) (fixnum l r))
         (%with-lseg (seg)
           (assert (and (<= 0 l) (<= l r) (<= r %n)))
           (unless (= l r)
             (incf l %size)
             (incf r %size)
             (loop for i of-type (integer 0 62) from %lg downto 1
                   do (unless (= (ash (ash l (- i)) i) l) (%lseg-push (ash l (- i))))
                      (unless (= (ash (ash r (- i)) i) r) (%lseg-push (ash (1- r) (- i)))))
             (let ((l2 l) (r2 r))
               (declare (fixnum l2 r2))
               (loop while (< l2 r2)
                     do (when (oddp l2)
                          (%lseg-all-apply l2 f)
                          (incf l2))
                        (when (oddp r2)
                          (decf r2)
                          (%lseg-all-apply r2 f))
                        (setf l2 (ash l2 -1)
                              r2 (ash r2 -1))))
             (loop for i of-type (integer 0 62) from 1 to %lg
                   do (unless (= (ash (ash l (- i)) i) l) (%lseg-update (ash l (- i))))
                      (unless (= (ash (ash r (- i)) i) r) (%lseg-update (ash (1- r) (- i))))))
           seg))

       (defun ,(name "-MAX-RIGHT") (seg l g)
         (declare (type lazy-segtree seg) (fixnum l))
         (%with-lseg (seg)
           (assert (and (<= 0 l) (<= l %n)))
           (assert (funcall g %e))
           (when (= l %n) (return-from ,(name "-MAX-RIGHT") %n))
           (incf l %size)
           (loop for i of-type (integer 0 62) from %lg downto 1
                 do (%lseg-push (ash l (- i))))
           (let ((sm %e))
             (loop
               (loop while (evenp l) do (setf l (ash l -1)))
               (unless (funcall g (%op sm (svref %d l)))
                 (loop while (< l %size)
                       do (%lseg-push l)
                          (setf l (* 2 l))
                          (let ((x (%op sm (svref %d l))))
                            (when (funcall g x)
                              (setf sm x)
                              (incf l))))
                 (return-from ,(name "-MAX-RIGHT") (- l %size)))
               (setf sm (%op sm (svref %d l)))
               (incf l)
               (when (= (logand l (- l)) l) (return)))
             %n)))

       (defun ,(name "-MIN-LEFT") (seg r g)
         (declare (type lazy-segtree seg) (fixnum r))
         (%with-lseg (seg)
           (assert (and (<= 0 r) (<= r %n)))
           (assert (funcall g %e))
           (when (= r 0) (return-from ,(name "-MIN-LEFT") 0))
           (incf r %size)
           (loop for i of-type (integer 0 62) from %lg downto 1
                 do (%lseg-push (ash (1- r) (- i))))
           (let ((sm %e))
             (loop
               (decf r)
               (loop while (and (> r 1) (oddp r)) do (setf r (ash r -1)))
               (unless (funcall g (%op (svref %d r) sm))
                 (loop while (< r %size)
                       do (%lseg-push r)
                          (setf r (1+ (* 2 r)))
                          (let ((x (%op (svref %d r) sm)))
                            (when (funcall g x)
                              (setf sm x)
                              (decf r))))
                 (return-from ,(name "-MIN-LEFT") (- (1+ r) %size)))
               (setf sm (%op (svref %d r) sm))
               (when (= (logand r (- r)) r) (return)))
             0)))
       ',prefix)))

(%lazy-segtree-template lazy-segtree (%lseg-op seg) (%lseg-mapping seg) (%lseg-composition seg))

(defmacro define-lazy-segtree (name &key op e mapping composition id)
  (flet ((sym (fmt) (intern (format nil fmt (symbol-name name)) (symbol-package name))))
    (let ((op-fn (sym "%~A-OP"))
          (mapping-fn (sym "%~A-MAPPING"))
          (composition-fn (sym "%~A-COMPOSITION")))
      `(progn
         (declaim (inline ,op-fn ,mapping-fn ,composition-fn))
         (defun ,op-fn (a b) (funcall ,op a b))
         (defun ,mapping-fn (f x) (funcall ,mapping f x))
         (defun ,composition-fn (f g) (funcall ,composition f g))
         (defun ,(sym "MAKE-~A") (n-or-vector)
           (make-lazy-segtree n-or-vector :op ,op :e ,e :mapping ,mapping
                                          :composition ,composition :id ,id))
         (%lazy-segtree-template ,name #',op-fn #',mapping-fn #',composition-fn)))))
