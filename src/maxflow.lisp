(in-package :ac-library)

(defstruct (%mf-e (:constructor %make-mf-e (to rev cap)) (:copier nil))
  (to 0 :type fixnum)
  (rev 0 :type fixnum)
  (cap 0 :type integer))

(defstruct (mf-edge (:constructor %make-mf-edge (from to cap flow)))
  from to cap flow)

(defstruct (mf-graph (:constructor %make-mf-graph (n g pos))
                     (:conc-name %mf-)
                     (:copier nil))
  (n 0 :type fixnum)
  (g #() :type simple-vector)
  pos)

(defun make-mf-graph (n)
  (assert (<= 0 n))
  (let ((g (make-array n)))
    (dotimes (i n) (setf (svref g i) (%make-growing-vector)))
    (%make-mf-graph n g (%make-growing-vector))))

(defun mf-graph-add-edge (graph from to cap)
  (let ((n (%mf-n graph))
        (g (%mf-g graph))
        (pos (%mf-pos graph)))
    (assert (and (<= 0 from) (< from n) (<= 0 to) (< to n) (<= 0 cap)))
    (let ((m (fill-pointer pos))
          (from-id (length (svref g from)))
          (to-id (length (svref g to))))
      (vector-push-extend (cons from from-id) pos)
      (when (= from to) (incf to-id))
      (vector-push-extend (%make-mf-e to to-id cap) (svref g from))
      (vector-push-extend (%make-mf-e from from-id 0) (svref g to))
      m)))

(defun %mf-edge-pair (graph i)
  (let ((pos (%mf-pos graph))
        (g (%mf-g graph)))
    (assert (and (<= 0 i) (< i (fill-pointer pos))))
    (destructuring-bind (from . idx) (aref pos i)
      (let* ((e (aref (svref g from) idx))
             (re (aref (svref g (%mf-e-to e)) (%mf-e-rev e))))
        (values from e re)))))

(defun mf-graph-get-edge (graph i)
  (multiple-value-bind (from e re) (%mf-edge-pair graph i)
    (%make-mf-edge from (%mf-e-to e) (+ (%mf-e-cap e) (%mf-e-cap re)) (%mf-e-cap re))))

(defun mf-graph-edges (graph)
  (loop for i below (fill-pointer (%mf-pos graph))
        collect (mf-graph-get-edge graph i)))

(defun mf-graph-change-edge (graph i new-cap new-flow)
  (assert (<= 0 new-flow new-cap))
  (multiple-value-bind (from e re) (%mf-edge-pair graph i)
    (declare (ignore from))
    (setf (%mf-e-cap e) (- new-cap new-flow)
          (%mf-e-cap re) new-flow)
    graph))

(defun mf-graph-flow (graph s tt &optional flow-limit)
  (let ((n (%mf-n graph))
        (g (%mf-g graph)))
    (assert (and (<= 0 s) (< s n) (<= 0 tt) (< tt n) (/= s tt)))
    (let ((level (%make-index-vector n))
          (iter (%make-index-vector n))
          (que (%make-index-vector n))
          (path-v (%make-index-vector (1+ n)))
          (path-e (make-array n))
          (flow 0))
      (flet ((limit-reached () (and flow-limit (>= flow flow-limit)))
             (bfs ()
               (fill level -1)
               (setf (aref level s) 0
                     (aref que 0) s)
               (let ((head 0) (tail 1))
                 (loop while (< head tail)
                       do (let ((v (aref que head)))
                            (incf head)
                            (loop for e across (svref g v)
                                  do (let ((to (%mf-e-to e)))
                                       (when (and (> (%mf-e-cap e) 0) (< (aref level to) 0))
                                         (setf (aref level to) (1+ (aref level v)))
                                         (when (= to tt) (return-from bfs))
                                         (setf (aref que tail) to)
                                         (incf tail)))))))))
        (loop
          (when (limit-reached) (return))
          (bfs)
          (when (< (aref level tt) 0) (return))
          (fill iter 0)
          (let ((depth 0)
                (tl (aref level tt)))
            (setf (aref path-v 0) s)
            (loop
              (when (limit-reached) (return))
              (let ((v (aref path-v depth)))
                (if (= v tt)
                    (let ((f (and flow-limit (- flow-limit flow))))
                      (dotimes (k depth)
                        (let ((c (%mf-e-cap (svref path-e k))))
                          (when (or (null f) (< c f)) (setf f c))))
                      (dotimes (k depth)
                        (let ((e (svref path-e k)))
                          (decf (%mf-e-cap e) f)
                          (incf (%mf-e-cap (aref (svref g (%mf-e-to e)) (%mf-e-rev e))) f)))
                      (incf flow f)
                      (let ((cut (loop for k below depth
                                       when (zerop (%mf-e-cap (svref path-e k))) return k)))
                        (when cut (setf depth cut))))
                    (let* ((adj (svref g v))
                           (len (length adj))
                           (found nil))
                      (loop while (< (aref iter v) len)
                            do (let* ((e (aref adj (aref iter v)))
                                      (to (%mf-e-to e)))
                                 (when (and (> (%mf-e-cap e) 0)
                                            (= (aref level to) (1+ (aref level v)))
                                            (or (= to tt) (< (aref level to) tl)))
                                   (setf found e)
                                   (return))
                                 (incf (aref iter v))))
                      (if found
                          (progn
                            (setf (svref path-e depth) found)
                            (incf depth)
                            (setf (aref path-v depth) (%mf-e-to found)))
                          (progn
                            (setf (aref level v) -1)
                            (when (= depth 0) (return))
                            (decf depth)
                            (incf (aref iter (aref path-v depth)))))))))))
        flow))))

(defun mf-graph-min-cut (graph s)
  (let* ((n (%mf-n graph))
         (g (%mf-g graph))
         (visited (make-array n :initial-element nil))
         (que (%make-index-vector n))
         (head 0)
         (tail 1))
    (setf (aref que 0) s
          (svref visited s) t)
    (loop while (< head tail)
          do (let ((p (aref que head)))
               (incf head)
               (loop for e across (svref g p)
                     do (when (and (> (%mf-e-cap e) 0) (not (svref visited (%mf-e-to e))))
                          (setf (svref visited (%mf-e-to e)) t
                                (aref que tail) (%mf-e-to e))
                          (incf tail)))))
    visited))
