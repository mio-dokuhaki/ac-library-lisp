(acl-include :lazysegtree :modint)

(declaim (optimize (speed 3) (safety 0)))

(declaim (inline pack-node node-sum node-len pack-affine affine-b affine-c))
(defun pack-node (sum len) (logior (ash sum 20) len))
(defun node-sum (x) (ash x -20))
(defun node-len (x) (logand x #xFFFFF))
(defun pack-affine (b c) (logior (ash b 30) c))
(defun affine-b (f) (ash f -30))
(defun affine-c (f) (logand f #x3FFFFFFF))

(define-lazy-segtree affine-seg
  :op (lambda (x y)
        (declare (fixnum x y))
        (pack-node (modint998244353+ (node-sum x) (node-sum y))
                   (+ (node-len x) (node-len y))))
  :e 0
  :mapping (lambda (f x)
             (declare (fixnum f x))
             (pack-node (modint998244353+ (modint998244353* (affine-b f) (node-sum x))
                                          (modint998244353* (affine-c f) (node-len x)))
                        (node-len x)))
  :composition (lambda (f g)
                 (declare (fixnum f g))
                 (pack-affine (modint998244353* (affine-b f) (affine-b g))
                              (modint998244353+ (modint998244353* (affine-b f) (affine-c g))
                                                (affine-c f))))
  :id (pack-affine 1 0))

(defun main ()
  (let* ((n (read))
         (q (read))
         (a (make-array n))
         (out (make-string-output-stream)))
    (dotimes (i n) (setf (svref a i) (pack-node (read) 1)))
    (let ((seg (make-affine-seg a)))
      (dotimes (i q)
        (if (= (read) 0)
            (let ((l (read)) (r (read)) (b (read)) (c (read)))
              (affine-seg-apply seg l r (pack-affine b c)))
            (let ((l (read)) (r (read)))
              (format out "~D~%" (node-sum (affine-seg-prod seg l r)))))))
    (write-string (get-output-stream-string out))))

(main)
